generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Alojamiento {
  id           Int    @id @default(autoincrement())
  tipo         String
  titulo       String
  calificacion String
  ubicacion    String
  precio       String
  imagen       String
  url_airbnb   String
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}